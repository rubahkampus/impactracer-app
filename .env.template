# ==========================================================================
# ImpacTracer v4.0 - Environment Configuration
# Copy this file to .env and fill in the required fields.
# All LLM calls are routed exclusively through OpenRouter.
# ==========================================================================

# REQUIRED: OpenRouter API Key
# Obtain from https://openrouter.ai/keys
OPENROUTER_API_KEY=

# LLM model (OpenRouter model ID — provider/model format)
# Options: google/gemini-2.5-flash, google/gemini-2.5-pro, deepseek/deepseek-r1
# LLM_MODEL=google/gemini-2.5-flash
# LLM_TEMPERATURE=0.0
# LLM_SEED=42

# Embedding and reranking models (local inference)
# EMBEDDING_MODEL=BAAI/bge-m3
# RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# EMBEDDING_BATCH_SIZE=32

# Index profile — selects the ./data/<profile>/ store root (one index per
# target repo, e.g. citrakara / nova). Override per-command with --profile,
# or per-shell with this env var. Default is "citrakara".
# IMPACTRACER_PROFILE=citrakara
#
# NOTE: DB_PATH / CHROMA_PATH / LLM_AUDIT_LOG_PATH / LOCKED_PARAMETERS_PATH are
# now DERIVED from the profile (get_settings rewrites them under
# ./data/<profile>/) and are no longer honored if set here.

# Indexer calibration
# TOP_K_TRACEABILITY=5
# MIN_TRACEABILITY_SIMILARITY=0.40
# DEGENERATE_EMBED_MIN_LENGTH=50

# Retrieval and reranking (env names map 1:1 to Settings in shared/config.py)
# TOP_K_PER_QUERY=30
# TOP_K_RRF_POOL=200
# MAX_ADMITTED_SEEDS=15
# RRF_K=60
# MIN_RERANKER_SCORE_FOR_VALIDATION=-2.0

# Plausibility gate (FR-C4) — density-only; there is no per-file count cap
# PLAUSIBILITY_GATE_DENSITY_THRESHOLD=0.50

# Step 1 — two-stage interpreter / anchor priming / project skeleton
# (VariantFlags.two_stage_interpret and .anchor_priming default True)
# PROJECT_SKELETON_PATH=./data/project_skeleton.txt
# ANCHOR_PRIMING_BOOST=0.10
# ANCHOR_PRIMING_BM25_BOOST=1.5

# Step 7.5 — sibling promotion
# ENABLE_SIBLING_PROMOTION=True
# SIBLING_PROMOTION_MAX_PER_FILE=12
# SIBLING_ADMIT_MAX_PER_FILE=4
# SIBLING_ADMIT_MAX_PER_CR=0

# Sensitivity-analysis toggle (code-only ablation)
# CODE_ONLY_MODE=False

# BFS
# BFS_GLOBAL_MAX_DEPTH=3
# BFS_HIGH_CONF_TOP_N=5

# Context window budget
# LLM_MAX_CONTEXT_TOKENS=100000

# Audit and evaluation output paths are profile-derived (see IMPACTRACER_PROFILE
# above): ./data/<profile>/llm_audit.jsonl and ./data/<profile>/locked_parameters.json.
